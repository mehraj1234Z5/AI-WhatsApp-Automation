# ========================================================
# Frontend Environment Configuration (Cloudflare Pages)
# ========================================================

# Backend API URL:
# - Leave empty when running locally with Vite proxy (defaults to /api)
# - For Cloudflare Pages deployment, set to your Cloudflare Tunnel public URL:
#   e.g. VITE_API_URL=https://wa-backend.yourdomain.com
#   or   VITE_API_URL=https://random-subdomain.trycloudflare.com
VITE_API_URL=
