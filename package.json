{
  "name": "ai-whatsapp-automation",
  "version": "1.0.0",
  "description": "AI-powered WhatsApp Content Automation System with local Ollama, React Dashboard, and Cloudflare Tunnel integration",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "node scripts/dev.js",
    "build:frontend": "npm run build --prefix frontend",
    "test": "node tests/run-tests.js",
    "seed": "node database/seed.js",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "ollama",
    "automation",
    "react",
    "cloudflare"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7",
    "whatsapp-web.js": "^1.26.0"
  }
}
