# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_string_for_production
JWT_EXPIRES_IN=7d
DEFAULT_ADMIN_EMAIL=admin@whatsappagent.local
DEFAULT_ADMIN_PASSWORD=adminpassword123

# Ollama Local AI Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_MS=120000

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./.wwebjs_auth
WHATSAPP_CLIENT_ID=ai-whatsapp-session
WHATSAPP_HEADLESS=true

# Database Configuration
DATABASE_PATH=./database/whatsapp_automation.sqlite

# Rate Limiting & Safety Controls
MAX_RETRIES=3
RETRY_DELAY_SEC=30
MAX_MESSAGES_PER_HOUR=30
MIN_DELAY_BETWEEN_MESSAGES_SEC=15
EMERGENCY_STOP_DEFAULT=false

# CORS & Network
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
